rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PTENit Firestore Security Rules
    // Allows public read of public catalog (courses, services, gigs, jobs, settings)
    // Allows writes for authenticated sessions or client application sync

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
